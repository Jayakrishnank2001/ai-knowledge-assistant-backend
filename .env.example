# Port the NestJS API listens on (defaults to 3001)
PORT=3001

# MongoDB Atlas connection string.
# Copy this file to .env and fill in your real connection string, e.g.:
#   mongodb+srv://<dbUser>:<dbPassword>@<your-cluster>.mongodb.net/?appName=Cluster0
# MONGODB_URI=

# JWT signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long an access token stays valid (e.g. 15m, 12h, 7d)
JWT_EXPIRES_IN=7d

# Database name used inside the cluster.
MONGODB_DBNAME=ai-knowledge-assistant

# --- CORS (browser origins allowed to call this API) --------------------------
# Comma-separated list, no trailing slashes. Omit to reflect any origin.
# Local dev + the deployed frontend:
CORS_ORIGINS=http://localhost:3000

# --- SMTP (signup OTP emails) -----------------------------------------------
# Used to email the 6-digit code when someone creates an account.
# Without these, signup still works locally: the code is printed to the
# backend console and returned as `devOtp` (never in production).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Nexa AI <no-reply@example.com>"

# Google Gemini API key. If set, enables real embeddings + LLM answers.
# Without it the app falls back to an offline mock embedder and mock answers.
# GEMINI_API_KEY=your-gemini-api-key

# Embedding model. Output is pinned to 1536 dimensions so it matches the Atlas
# Vector Search index - changing this model requires `npm run reindex`.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Chat model. Thinking models spend part of maxOutputTokens on reasoning tokens,
# so keep the budget generous.
# Can also be changed at runtime from the app: Settings -> AI Preferences rewrites
# this line (allowed: gemini-3.8-flash, gemini-3.7-flash, gemini-3.6-flash,
# gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-3-flash-preview).
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# --- Retrieval tuning (all optional) ----------------------------------------

# Minimum cosine similarity a chunk must reach to be used as context.
# Omit to use the active provider's default (mock: 0.12, Gemini: 0.5).
# RAG_MIN_SIMILARITY=0.5

# Maximum number of chunks handed to the LLM.
# RAG_TOP_K=6

# Maximum chunks taken from any single document (keeps sources diverse).
# RAG_MAX_CHUNKS_PER_DOCUMENT=3

# Drop chunks scoring more than this below the best match (trims boilerplate
# sources while keeping genuinely close contenders).
# RAG_RELEVANCE_MARGIN=0.04